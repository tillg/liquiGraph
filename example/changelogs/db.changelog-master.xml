<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-create-author" author="liquigraph">
        <createTable tableName="author">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="birth_year" type="INT"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-book" author="liquigraph">
        <createTable tableName="book">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="published_year" type="INT"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="book"
            baseColumnNames="author_id"
            referencedTableName="author"
            referencedColumnNames="id"
            constraintName="fk_book_author"/>

        <createIndex tableName="book" indexName="idx_book_author_id">
            <column name="author_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
